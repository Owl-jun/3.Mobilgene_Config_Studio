{
"version": "0.2.0",
"configurations": [
    {
    "name": "Debug ggg.py with Streamlit",
    "type": "debugpy",
    "request": "launch",
    "module": "streamlit",
    "args": [
        "run",
        "ggg.py",
        "--server.port",
        "8501"
    ],
    "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "console": "integratedTerminal",
    "justMyCode": true
    }
]
}